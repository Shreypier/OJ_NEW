# Example production settings. setup_server.sh creates the real file at /etc/codelang.env
# (never commit that one: it holds the secret key).

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourname.duckdns.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.duckdns.org
# Set to 1 after HTTPS is working (certbot), then restart the service.
DJANGO_HTTPS=0
DJANGO_DB_PATH=/var/lib/codelang/db.sqlite3

# Judge
JUDGE_BACKEND=docker
# 1 on a 1 GB server, 2 on a 2 GB server
JUDGE_MAX_CONCURRENT=1
# JUDGE_CONTAINER_MEMORY_MB=512
